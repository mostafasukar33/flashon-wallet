// "شوفه من موبايل تاني": w.flashoneg.com (حرف واحد عمداً: برنامج الحسابات مبيقبلش اسم شركة أقل من حرفين،
// فمستحيل شركة تاخد اللينك ده، والـ Custom Domain ده بيلمس w.flashoneg.com بس ومش بيغير أي route أو لينك تاني)
// التطبيق بيرفع الحساب مقفول بمفتاح من الباسورد (AES-GCM)، والسيرفر عمره ما بيشوف باسورد ولا أرقام.
// الشاشات هي نفس app/src/main/assets/web/index.html، والسيرفر بيحط فيها view.html (وضع الاطلاع بس)، وsw.txt للإشعارات.
// الرفع: cd server && node test/api.js && CLOUDFLARE_API_TOKEN="$cloudflare_api_token" npx wrangler deploy
// المفتاح السري للإشعارات VAPID_PRIVATE متخزن في كلاود فلير (wrangler secret)، ولازم يفضل مع VAPID_PUBLIC اللي تحت.
// ممنوع route بنجمة *.flashoneg.com (هيخطف برنامج الحسابات)
{
  "name": "flashon-wallet",
  "main": "src/index.js",
  "compatibility_date": "2025-10-01",
  "assets": { "directory": "../app/src/main/assets/web", "binding": "ASSETS", "run_worker_first": ["/", "/index.html", "/api/*", "/icon.png", "/manifest.webmanifest", "/sw.js", "/v/*", "/m/*"] },
  "durable_objects": { "bindings": [ { "name": "BOX", "class_name": "Box" } ] },
  "migrations": [ { "tag": "v1", "new_sqlite_classes": ["Box"] } ],
  "vars": { "VAPID_PUBLIC": "BMIaC2-NpQ0xWe3vzaQNZtGVH0TbwoTTmzg47Cw_mC6vCinEnEK-27yjr-9o6Roc7afB5ZBysycaO_DL_tlUZqc" },
  // الـ route بتاع w.flashoneg.com/* لازم يفضل: من غيره الـ route بنجمة بتاع برنامج الحسابات بيلقط الطلبات (زي flash.flashoneg.com/*)
  "routes": [ { "pattern": "w.flashoneg.com", "custom_domain": true }, { "pattern": "w.flashoneg.com/*", "zone_name": "flashoneg.com" } ],
  // سجل الطلبات والأخطاء في كلاود فلير (مجاني): لو الإشعار أو الرفع وقف نعرف السبب على طول
  "observability": { "enabled": true, "head_sampling_rate": 1 }
}
